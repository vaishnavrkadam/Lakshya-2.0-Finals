rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Live competition state and scoring data
    match /liveState/{document=**} {
      allow read: if true;
      allow write: if (request.resource != null && request.resource.data.adminKey == "L@kshy@2.O_Secure_Auth_Token_2026") || request.auth != null;
    }

    // Finalists and shoot records
    match /finalists/{document=**} {
      allow read: if true;
      allow write: if (request.resource != null && request.resource.data.adminKey == "L@kshy@2.O_Secure_Auth_Token_2026") || request.auth != null;
    }

    // Audit logs
    match /auditLogs/{document=**} {
      allow read: if true;
      allow write: if (request.resource != null && request.resource.data.adminKey == "L@kshy@2.O_Secure_Auth_Token_2026") || request.auth != null;
    }
  }
}
